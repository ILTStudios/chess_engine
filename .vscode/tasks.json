{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++.exe build all files",
            "command": "powershell",
            "args": [
                "-Command",
                "$files = (Get-ChildItem -Recurse -Filter *.cpp).FullName -join \" \"; & C:/msys64/ucrt64/bin/g++.exe -Wall -Wextra -g3 $files -o \"${workspaceFolder}/src/game/output/game.exe\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds all .cpp files recursively using PowerShell string joining."
        }
    ],
    "version": "2.0.0"
}